{
  "name": "briefloop-desktop",
  "version": "0.28.0",
  "private": true,
  "description": "BriefLoop local desktop workspace",
  "author": "Stahl-G",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "pack": "electron-builder --mac dir --arm64 --publish never",
    "dist": "electron-builder --mac dmg zip --arm64 --publish never && node scripts/prepare-update-blockmaps.cjs",
    "postinstall": "node node_modules/electron/install.js",
    "dist:signed": "node scripts/build-mac-signed.cjs",
    "signing:check": "node scripts/build-mac-signed.cjs --check"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "beforePack": "scripts/verify-backend.cjs",
    "appId": "ai.briefloop.desktop",
    "productName": "BriefLoop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.cjs",
      "welcome.html",
      "welcome.css",
      "welcome.js",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/Mac.icns"
    },
    "dmg": {
      "sign": false,
      "writeUpdateInfo": true,
      "background": "assets/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 210
        },
        {
          "x": 390,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": null,
    "win": {
      "icon": "assets/Win.ico"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "semver": "7.8.5"
  }
}
