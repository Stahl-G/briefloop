recursive-include docs *.md
include VERSION README.md THIRD_PARTY_NOTICES.md CHANGELOG.md bootstrap.py start.sh package.json package-lock.json
recursive-include vendor/wheels *.whl *.md
recursive-include frontend *.js
recursive-include src/briefloop/static *
recursive-include src/briefloop/skill_assets *.md
prune workspaces
prune private_planning
global-exclude __pycache__ *.py[cod] .DS_Store

recursive-include runtime-bridge *.ts *.mjs *.json *.md
recursive-include third_party/open-design *
recursive-include examples *.md *.txt
prune output
